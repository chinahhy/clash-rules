{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🚀 自动优选"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "fakeipfilter-cn",
          "private_domain",
          "cn_domain"
        ],
        "server": "ali"
      },
      {
        "rule_set": "fakeipfilter-!cn",
        "server": "google"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 4096,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "tag": "🚀 自动优选",
      "type": "urltest",
      "outbounds": [],
      "url": "https://clients1.google.com/generate_204",
      "interval": "300s",
      "tolerance": 100,
      "interrupt_exist_connections": false
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "ali"
    }
  ],
  "http_clients": [
    {
      "tag": "直连下载",
      "detour": "直连"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "port": [
              53,
              853
            ],
            "invert": true
          },
          {
            "clash_mode": "Global",
            "invert": true
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "ip_is_private": true
              },
              {
                "rule_set": "cn_ip"
              }
            ]
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "telegram_ip"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns"
        ],
        "timeout": "100ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "rule_set": [
          "private_domain",
          "private_ip"
        ],
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": [
              "stun",
              "quic"
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "action": "resolve"
      },
      {
        "network": "icmp",
        "outbound": "直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "🚀 自动优选"
      },
      {
        "rule_set": [
          "youtube_domain",
          "telegram_domain",
          "twitter_domain",
          "telegram_ip",
          "twitter_ip"
        ],
        "outbound": "🚀 自动优选"
      },
      {
        "domain_suffix": [
          "googlevideo.com",
          "youtube.com",
          "youtu.be",
          "ytimg.com",
          "youtubei.googleapis.com",
          "twimg.com",
          "x.com",
          "twitter.com",
          "t.co",
          "t.me",
          "telegram.org",
          "telegram.me",
          "telegram.dog",
          "telegram-cdn.org"
        ],
        "outbound": "🚀 自动优选"
      },
      {
        "rule_set": "cn_domain",
        "outbound": "直连"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "cn_ip",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "fakeipfilter-cn",
          "fakeipfilter-!cn"
        ],
        "type": "remote",
        "format": "source",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/chinahhy/clash-rules/main/sing-box/rules/{tag}.json",
        "update_interval": "24h"
      },
      {
        "tag": [
          "youtube_domain",
          "telegram_domain",
          "telegram_ip",
          "twitter_domain",
          "twitter_ip",
          "private_domain",
          "private_ip",
          "cn_domain",
          "cn_ip"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/chinahhy/clash-rules/main/sing-box/rules/{tag}.srs",
        "update_interval": "24h"
      }
    ],
    "final": "🚀 自动优选",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    }
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 6666
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "HHYlove142536",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard",
        "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "secret": "HHYlove142536",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
